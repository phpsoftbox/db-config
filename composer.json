{
    "name": "phpsoftbox/db-config",
    "description": "DB Config component for the PhpSoftBox framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anton K.",
            "email": "inspector-who@mail.ru"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^8.5",
        "phpsoftbox/database": "^1.0",
        "phpsoftbox/forms": "^1.0",
        "phpsoftbox/validator": "^1.0"
    },
    "require-dev": {
        "phpsoftbox/cs-fixer": "^1.2.2",
        "phpsoftbox/filter": "^1.0",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "PhpSoftBox\\DbConfig\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSoftBox\\DbConfig\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs:fix": "vendor/bin/psb-cs-fixer fix",
        "cs:check": "vendor/bin/psb-cs-fixer check --diff"
    },
    "prefer-stable": true
}
